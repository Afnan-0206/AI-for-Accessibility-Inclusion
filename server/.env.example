# Server Configuration
# On Render, PORT is automatically injected (default 10000). For local dev use 5000.
PORT=5000
NODE_ENV=production

# Frontend Origin(s) for CORS:
# Set to your Vercel deployment URL (e.g., https://samajh.vercel.app).
# You can provide multiple comma-separated URLs or '*' (Render/Vercel preview support is built-in).
CLIENT_ORIGIN=http://localhost:5173

# Supabase PostgreSQL Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
# Use your service_role secret key so backend can access data securely:
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# JWT Authentication Secret
# Generate any secure random string (Render blueprint can generate this automatically)
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars

# Google Gemini API Configuration (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

