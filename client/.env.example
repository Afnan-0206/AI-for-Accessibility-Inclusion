# Backend API URL:
# For local development: http://localhost:5000/api
# For Vercel production: point to your Render backend (e.g. https://samajh-backend.onrender.com/api)
VITE_API_URL=http://localhost:5000/api

# Mock Mode:
# Set to 'false' to connect to the real backend, or 'true' to use simulated local responses
VITE_USE_MOCK=false

